import {
    Elevation,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialTypography,
    ScrollView,
    Slider,
    MaterialText,
} from "@material/material.slint";
import { BaseButton } from "@material/ui/components/base_button.slint";
import { ConfigSlint } from "../shared-items.slint";
import { MaterialPalette } from "../material-1.0/material.slint";


export struct BrightnessItem {
    brightness: int,
    id: string,
    name: string,
}

export struct ExternalBrightnessState {
    brightness_items: [BrightnessItem],
}

export component BrightnessButton inherits Rectangle {
    height: 100%;

    in property <int> brightness;

    callback brightness_clicked();
    callback brightness_right_clicked();
    callback brightness_scroll_up();
    callback brightness_scroll_down();

    HorizontalLayout {
        spacing: 4px;
        padding: 3px;
        height: 100%;

        Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_28;

            elevation := Elevation {
                border_radius: parent.border_radius;
                width: 100%;
                height: 100%;
                background: transparent;
            }

            base := BaseButton {
                border_radius: parent.border_radius;
                width: 100%;

                icon: root.brightness <= 33
                    ? @image-url("../assets/brightness/20x20/brightness_0.svg")
                    : root.brightness <= 66
                    ? @image-url("../assets/brightness/20x20/brightness_1.svg")
                    : @image-url("../assets/brightness/20x20/brightness_2.svg");

                text: root.brightness + "%";
                style: MaterialTypography.label_medium;
                spacing: MaterialStyleMetrics.spacing_4;

                icon-size: 20px;
                button_horizontal_padding: MaterialStyleMetrics.padding_4;
                icon_color: transparent;
                color: MaterialPalette.on_surface;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        if (event.button == PointerEventButton.left) {
                            root.brightness_clicked();
                        }
                        if (event.button == PointerEventButton.right) {
                            root.brightness_right_clicked();
                        }
                    }
                }

                scroll-event(event) => {
                    if (event.delta-y < 0) {
                        root.brightness_scroll_up();
                    } else if (event.delta-y > 0) {
                        root.brightness_scroll_down();
                    }
                    accept
                }
            }

            states [
                hover when base.has_hover && !base.pressed && !base.enter_pressed: {
                    elevation.level: 2;
                    elevation.background: MaterialPalette.surface_container_high;
                }
                pressed when base.pressed || base.enter_pressed: {
                    elevation.level: 1;
                    elevation.background: MaterialPalette.surface_container_highest;
                }
            ]
        }
    }
}

export component BrightnessPopup inherits Rectangle {
    in-out property <int> brightness;
    in-out property <ExternalBrightnessState> extBrightnessData;
    in property <ConfigSlint> config;
    in property <bool> popup_visible;

    callback set_brightness(int);
    callback set_external_brightness(string, int);
    callback refresh_external_brightness();

    animate height {
        duration: 350ms * config.interaction.animation-multiplier;
        easing: ease-in-out-back;
    }
    width: 330px;
    height: root.popup_visible ? clamp(layout.preferred-height, 0px, config.window.bar-popup-max-height) : 0px;
    clip: true;

    TouchArea {
        elevation := Elevation {
            level: 2;
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.surface_container_low;
            width: 100%;
            height: 100%;

            layout := VerticalLayout {
                width: 100%;
                spacing: 6px;
                alignment: start;
                padding: MaterialStyleMetrics.padding_12;

                HorizontalLayout {
                    alignment: center;
                    width: 100%;

                    Text {
                        text: "Display Brightness";
                        font-size: MaterialTypography.label_large.font_size;
                        font-weight: MaterialTypography.label_large.font-weight;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Brightness";
                                font-size: MaterialTypography.label_medium.font_size;
                                font-weight: MaterialTypography.label_medium.font-weight;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }

                        Rectangle {
                            border_radius: MaterialStyleMetrics.border_radius_28;
                            elevation_refresh := Elevation {
                                border_radius: parent.border_radius;
                                width: 100%;
                                height: 100%;
                                background: transparent;
                            }

                            base_refresh := BaseButton {
                                border_radius: parent.border_radius;
                                width: 100%;
                                icon: @image-url("../assets/refresh_22.svg");
                                icon-size: 20px;
                                button_horizontal_padding: MaterialStyleMetrics.padding_8;
                                icon_color: transparent;
                                color: MaterialPalette.on_surface;

                                clicked => {
                                    root.refresh_external_brightness();
                                }
                            }

                            states [
                                hover when base_refresh.has_hover && !base_refresh.pressed: {
                                    elevation_refresh.level: 2;
                                    elevation_refresh.background: MaterialPalette.surface_container_high;
                                }
                                pressed when base_refresh.pressed: {
                                    elevation_refresh.level: 1;
                                    elevation_refresh.background: MaterialPalette.surface_container_highest;
                                }
                            ]
                        }
                    }

                    Rectangle {
                        height: 54px;
                        border_radius: MaterialStyleMetrics.border_radius_12;
                        background: MaterialPalette.surface_container_highest;

                        HorizontalLayout {
                            padding-left: MaterialStyleMetrics.padding_12;
                            padding-right: MaterialStyleMetrics.padding_12;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 25px;
                                    height: 25px;
                                    source: root.brightness <= 33
                                        ? @image-url("../assets/brightness/25x25/brightness_0.svg")
                                        : root.brightness <= 66
                                        ? @image-url("../assets/brightness/25x25/brightness_1.svg")
                                        : @image-url("../assets/brightness/25x25/brightness_2.svg");
                                }
                            }

                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 100;
                                thickness: 10px;
                                background_color: MaterialPalette.surface_container;
                                value <=> root.brightness;
                                changed(val) => {
                                    root.set_brightness(round(val));
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.brightness + "%";
                                    font-size: MaterialTypography.body_medium.font_size;
                                    color: MaterialPalette.on_surface;
                                    width: 36px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }

                if root.extBrightnessData.brightness_items.length > 0: Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                if root.extBrightnessData.brightness_items.length > 0: HorizontalLayout {
                    width: 100%;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "External Monitors";
                            font-size: MaterialTypography.label_medium.font_size;
                            font-weight: MaterialTypography.label_medium.font-weight;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                }
                if root.extBrightnessData.brightness_items.length > 0: Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    preferred-height: clamp(scroll_content.preferred-height, 0px, 200px);

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        overlay_scrollbars: true;

                        scroll_content := VerticalLayout {
                            width: 100%;
                            spacing: 8px;
                            padding: 2px;

                            for monitor in root.extBrightnessData.brightness_items: Rectangle {
                                height: 64px;
                                border_radius: MaterialStyleMetrics.border_radius_12;
                                background: MaterialPalette.surface_container_highest;
                                HorizontalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: monitor.name != "" ? monitor.name : "External Display";
                                        style: MaterialTypography.body_medium;
                                        overflow: elide;
                                        vertical-stretch: 0;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: MaterialStyleMetrics.padding_12;
                                    padding-right: MaterialStyleMetrics.padding_12;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        vertical-stretch: 0;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    width: 25px;
                                                    height: 25px;
                                                    source: @image-url("../assets/brightness/25x25/brightness_external.svg");
                                                }
                                            }

                                            Slider {
                                                horizontal-stretch: 1;
                                                minimum: 0;
                                                maximum: 100;
                                                thickness: 10px;
                                                background_color: MaterialPalette.surface_container;
                                                value <=> monitor.brightness;
                                                released(val) => {
                                                    root.set_external_brightness(monitor.id, val);
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Text {
                                            text: monitor.brightness + "%";
                                            font-size: MaterialTypography.body_medium.font_size;
                                            color: MaterialPalette.on_surface;
                                            width: 36px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
