import {
    Elevation,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    Switch,
    ScrollView,
} from "@material/material.slint";
import { BaseButton } from "@material/ui/components/base_button.slint";
import {
    MaterialStyleMetrics,
    MaterialTypography,
} from "../material-1.0/material.slint";
import { ConfigSlint } from "../shared-items.slint";
import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";

export struct BluetoothItem {
    name: string,
    address: string,
    connected: bool,
    device_type: string,
}

export struct CompleteBluetoothState {
    available: bool,
    enabled: bool,
    connected_devices: [BluetoothItem],
    discovered_devices: [BluetoothItem],
}

export component BluetoothButton inherits Rectangle {
    height: 100%;
    in property <CompleteBluetoothState> bluetooth;
    callback bluetooth_clicked();

    HorizontalLayout {
        spacing: 4px;
        padding: 3px;
        height: 100%;

        Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_28;
            elevation := Elevation {
                border_radius: parent.border_radius;
                width: 100%;
                height: 100%;
                background: transparent;
            }

            base := BaseButton {
                border_radius: parent.border_radius;
                width: 100%;
                
                icon: !root.bluetooth.available ? @image-url("../assets/bluetooth/20x20/bluetooth_disabled.svg") :
                      !root.bluetooth.enabled ? @image-url("../assets/bluetooth/20x20/bluetooth.svg") :
                      root.bluetooth.connected_devices.length > 0 ? @image-url("../assets/bluetooth/20x20/bluetooth_connected.svg") :
                                                                    @image-url("../assets/bluetooth/20x20/bluetooth.svg");

                spacing: 4px;
                icon-size: 20px;
                button_horizontal_padding: MaterialStyleMetrics.padding_8;
                icon_color: MaterialPalette.on_surface;
                color: MaterialPalette.on_surface;

                clicked => {
                    root.bluetooth_clicked();
                }
            }

            states [
                hover when base.has_hover && !base.pressed && !base.enter_pressed: {
                    elevation.level: 2;
                    elevation.background: MaterialPalette.surface_container_high;
                }
                pressed when base.pressed || base.enter_pressed: {
                    elevation.level: 1;
                    elevation.background: MaterialPalette.surface_container_highest;
                }
            ]
        }
    }
}

export component BluetoothPopup inherits Rectangle {
    in property <CompleteBluetoothState> bluetooth;
    in property <ConfigSlint> config;
    in property <bool> popup_visible;

    callback set_bluetooth_enabled(bool);
    callback connect_bluetooth_device(string);
    callback disconnect_bluetooth_device(string);
    callback start_bluetooth_discovery();

    animate height {
        duration: 350ms * config.interaction.animation-multiplier;
        easing: ease-in-out-back;
    }
    width: 330px;
    height: root.popup_visible ? clamp(layout.preferred-height, 0px, config.window.bar-popup-max-height) : 0px;
    clip: true;

    TouchArea {
        elevation := Elevation {
            level: 2;
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.surface_container_low;
            width: 100%;
            height: 100%;

            layout := VerticalLayout {
                width: 100%;
                spacing: 8px;
                alignment: start;
                padding: MaterialStyleMetrics.padding_12;

                Text {
                    text: "Bluetooth Configuration";
                    font-size: MaterialTypography.label_large.font_size;
                    font-weight: MaterialTypography.label_large.font-weight;
                    horizontal-alignment: center;
                }

                if root.bluetooth.enabled && root.bluetooth.connected_devices.length > 0:Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                if root.bluetooth.enabled && root.bluetooth.connected_devices.length > 0:Text {
                    text: "Connected devices";
                    font-size: MaterialTypography.label_medium.font_size;
                    font-weight: MaterialTypography.label_medium.font-weight;
                    color: MaterialPalette.on_surface_variant;
                }

                VerticalLayout {
                    spacing: 6px;

                    if root.bluetooth.enabled && root.bluetooth.connected_devices.length > 0: VerticalLayout {
                        spacing: 6px;
                        for device in root.bluetooth.connected_devices: Rectangle {
                            height: 48px;
                            border_radius: MaterialStyleMetrics.border_radius_12;
                            background: MaterialPalette.surface_container_highest;

                            HorizontalLayout {
                                padding-left: MaterialStyleMetrics.padding_12;
                                padding-right: MaterialStyleMetrics.padding_8;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        width: 25px;
                                        height: 25px;
                                        source: device.device_type == "audio" || device.device_type == "audio-card" || device.device_type == "audio-headset" ? @image-url("../assets/bluetooth/25x25/headphones.svg") :
                                            device.device_type == "input-keyboard" || device.device_type == "keyboard" ? @image-url("../assets/bluetooth/25x25/keyboard.svg") :
                                            device.device_type == "input-mouse" || device.device_type == "mouse" ? @image-url("../assets/bluetooth/25x25/mouse.svg") :
                                            @image-url("../assets/bluetooth/25x25/bluetooth_connected.svg");
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    MaterialText {
                                        text: device.name;
                                        style: MaterialTypography.body_large;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: device.address;
                                        font-size: 11px;
                                        color: MaterialPalette.primary;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 0;
                                    width: 4px;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        height: 32px;
                                        border_radius: MaterialStyleMetrics.border_radius_28;
                                        disc_el := Elevation {
                                            border_radius: parent.border_radius;
                                            background: MaterialPalette.error_container;
                                        }

                                        BaseButton {
                                            border_radius: parent.border_radius;
                                            text: "Disconnect";
                                            color: MaterialPalette.on_error_container;
                                            clicked => { disconnect_bluetooth_device(device.address); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "Bluetooth Status";
                            font-size: MaterialTypography.label_medium.font_size;
                            font-weight: MaterialTypography.label_medium.font-weight;
                            color: MaterialPalette.on_surface_variant;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Switch {
                                height_switch: MaterialStyleMetrics.size_24;
                                width_switch: MaterialStyleMetrics.size_40;
                                checked: root.bluetooth.enabled;
                                enabled: root.bluetooth.available;
                                checked_state_changed(enabled) => { root.set_bluetooth_enabled(enabled); };
                            }
                        }
                    }

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_28;
                        elevation_refresh := Elevation {
                            border_radius: parent.border_radius;
                            width: 100%;
                            height: 100%;
                            background: transparent;
                        }

                        base_refresh := BaseButton {
                            border_radius: parent.border_radius;
                            width: 100%;
                            enabled: root.bluetooth.enabled;
                            icon: @image-url("../assets/refresh_22.svg");
                            icon-size: 22px;
                            button_horizontal_padding: MaterialStyleMetrics.padding_8;
                            icon_color: transparent;
                            color: MaterialPalette.on_surface;

                            clicked => {
                                root.start_bluetooth_discovery();
                            }
                        }

                        states [
                            hover when base_refresh.has_hover && !base_refresh.pressed && !base_refresh.enter_pressed: {
                                elevation_refresh.level: 2;
                                elevation_refresh.background: MaterialPalette.surface_container_high;
                            }
                            pressed when base_refresh.pressed || base_refresh.enter_pressed: {
                                elevation_refresh.level: 1;
                                elevation_refresh.background: MaterialPalette.surface_container_highest;
                            }
                        ]
                    }
                }

                if root.bluetooth.enabled && root.bluetooth.discovered_devices.length > 0: Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    preferred-height: scroll_content.preferred-height;

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        overlay_scrollbars: true;

                        scroll_content := VerticalLayout {
                            width: 100%;
                            spacing: 6px;
                            padding: 2px;

                            for device in root.bluetooth.discovered_devices: Rectangle {
                                height: 48px;
                                border_radius: MaterialStyleMetrics.border_radius_12;
                                background: MaterialPalette.surface_container_highest;

                                HorizontalLayout {
                                    padding-left: MaterialStyleMetrics.padding_12;
                                    padding-right: MaterialStyleMetrics.padding_8;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Image {
                                            width: 25px;
                                            height: 25px;
                                            source: device.device_type == "audio" || device.device_type == "audio-card" || device.device_type == "audio-headset" ? @image-url("../assets/bluetooth/25x25/headphones.svg") :
                                                device.device_type == "input-keyboard" || device.device_type == "keyboard" ? @image-url("../assets/bluetooth/25x25/keyboard.svg") :
                                                device.device_type == "input-mouse" || device.device_type == "mouse" ? @image-url("../assets/bluetooth/25x25/mouse.svg") :
                                                @image-url("../assets/bluetooth/25x25/bluetooth.svg");
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        MaterialText {
                                            text: device.name;
                                            style: MaterialTypography.body_large;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: device.address;
                                            font-size: 11px;
                                            opacity: 0.6;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 0;
                                        width: 4px;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Rectangle {
                                            height: 32px;
                                            border_radius: MaterialStyleMetrics.border_radius_28;

                                            conn_el := Elevation {
                                                border_radius: parent.border_radius;
                                                background: MaterialPalette.secondary_container;
                                            }

                                            BaseButton {
                                                border_radius: parent.border_radius;
                                                text: "Connect";
                                                color: MaterialPalette.on_secondary_container;
                                                clicked => {
                                                    root.connect_bluetooth_device(device.address);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
