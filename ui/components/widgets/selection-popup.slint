import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText,
    ScrollView,
    StateLayer,
    IconButton,
} from "@material/material.slint";

export component SelectionPopup inherits PopupWindow {
    // Styling and positioning configuration
    in property <length> popup-width: 180px;
    in property <length> popup-height: 200px;
    in property <string> title: "";
    in property <bool> show-title: root.title != "";

    // Data model properties
    in property <[string]> options: [];
    in property <int> selected-index: -1;
    in property <string> selected-text: "";

    // Callbacks for external state management
    callback item-selected(index: int, value: string);

    // Dynamic resolution of active index without imperative loops
    property <int> text_matched_index: -1;

    // Calculated active index (string match takes precedence if valid, otherwise fallback to selected-index)
    property <int> active_index: root.text_matched_index != -1
        ? root.text_matched_index
        : root.selected-index;

    // Item height + spacing used for scroll calculation (32px + 2px = 34px)
    property <length> item_row_height: 34px;

    // Geometry overrides
    width: root.popup-width;
    height: root.popup-height;
    close-policy: close-on-click-outside;

    popup_rect := Rectangle {
        width: 100%;
        height: 100%;
        drop-shadow-blur: 8px;
        drop-shadow-color: rgba(0, 0, 0, 0.40);
        background: MaterialPalette.surface_container_highest;
        border-radius: MaterialStyleMetrics.border_radius_12;

        VerticalLayout {
            padding: MaterialStyleMetrics.padding_8;
            spacing: MaterialStyleMetrics.spacing_4;

            if root.show-title: Text {
                text: root.title;
                font-size: MaterialTypography.title_small.font-size;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 1px;
                background: MaterialPalette.outline_variant;
            }

            ScrollView {
                // Fixed: Multiplied by unitless -1 to keep result in length units (px)
                viewport-y: -1 * (max(0, root.active_index - 2) * root.item_row_height);

                animate viewport-y {
                    duration: 150ms;
                    easing: ease-out;
                }

                VerticalLayout {
                    spacing: 2px;

                    for item[index] in root.options: TouchArea {
                        height: 32px;

                        init => {
                            if (root.selected-text != "" && item == root.selected-text) {
                                root.text_matched_index = index;
                            }
                        }

                        clicked => {
                            root.item-selected(index, item);
                            root.close();
                        }

                        Rectangle {
                            background: index == root.active_index
                                ? MaterialPalette.primary_container
                                : transparent;
                            border-radius: MaterialStyleMetrics.border_radius_4;

                            Text {
                                text: item;
                                font-size: MaterialTypography.body_large.font-size;
                                font-weight: index == root.active_index ? 700 : 400;
                                color: index == root.active_index
                                    ? MaterialPalette.on_primary_container
                                    : MaterialPalette.on_surface;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
