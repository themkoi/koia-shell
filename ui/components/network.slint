import {
    Elevation,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    Switch,
    ScrollView,
} from "@material/material.slint";
import { BaseButton } from "@material/ui/components/base_button.slint";
import {
    MaterialStyleMetrics,
    MaterialTypography,
} from "../material-1.0/material.slint";
import { ConfigSlint } from "../shared-items.slint";
import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";

export struct NetworkItem {
    ssid: string,
    strength: int,
    locked: bool,
}

export struct CompleteNetworkState {
    wifi_networks: [NetworkItem],
    wifi_ip: string,
    wifi_enabled: bool,
    current_ssid: string,
    current_strength: int,
    wired_connected: bool,
    wired_ip: string,
}

export component NetworkButton inherits Rectangle {
    height: 100%;
    in property <CompleteNetworkState> network;
    callback network_clicked();

    HorizontalLayout {
        spacing: 4px;
        padding: 3px;
        height: 100%;

        Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_28;
            elevation := Elevation {
                border_radius: parent.border_radius;
                width: 100%;
                height: 100%;
                background: transparent;
            }

            base := BaseButton {
                border_radius: parent.border_radius;
                width: 100%;
                icon: root.network.wired_connected ? @image-url("../assets/network/20x20/ethernet.svg") :
                    !root.network.wifi_enabled ? @image-url("../assets/network/20x20/wifi_off.svg") :
                    root.network.current_strength < 20 ? @image-url("../assets/network/20x20/wifi_0.svg") :
                    root.network.current_strength < 40 ? @image-url("../assets/network/20x20/wifi_1.svg") :
                    root.network.current_strength < 60 ? @image-url("../assets/network/20x20/wifi_2.svg") :
                    root.network.current_strength < 80 ? @image-url("../assets/network/20x20/wifi_3.svg") :
                    @image-url("../assets/network/20x20/wifi_4.svg");

                spacing: 4px;
                icon-size: 20px;
                button_horizontal_padding: MaterialStyleMetrics.padding_8;
                icon_color: MaterialPalette.on_surface;
                color: MaterialPalette.on_surface;

                clicked => {
                    root.network_clicked();
                }
            }

            states [
                hover when base.has_hover && !base.pressed && !base.enter_pressed: {
                    elevation.level: 2;
                    elevation.background: MaterialPalette.surface_container_high;
                }
                pressed when base.pressed || base.enter_pressed: {
                    elevation.level: 1;
                    elevation.background: MaterialPalette.surface_container_highest;
                }
            ]
        }
    }
}

export component NetworkPopup inherits Rectangle {
    in property <CompleteNetworkState> network;
    in property <ConfigSlint> config;
    in property <bool> popup_visible;

    callback set_wifi_enabled(bool);
    callback disconnect_wifi();
    callback connect_wifi(string);
    callback refresh_networks();

    animate height {
        duration: 350ms * config.interaction.animation-multiplier;
        easing: ease-in-out-back;
    }
    width: 330px;
    height: root.popup_visible ? clamp(layout.preferred-height, 0px, config.window.bar-popup-max-height) : 0px;
    clip: true;

    TouchArea {
        elevation := Elevation {
            level: 2;
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.surface_container_low;
            width: 100%;
            height: 100%;

            layout := VerticalLayout {
                width: 100%;
                spacing: 8px;
                alignment: start;
                padding: MaterialStyleMetrics.padding_12;

                Text {
                    text: "Network Configuration";
                    font-size: MaterialTypography.label_large.font_size;
                    font-weight: MaterialTypography.label_large.font-weight;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                Text {
                    text: "Network Interfaces";
                    font-size: MaterialTypography.label_medium.font_size;
                    font-weight: MaterialTypography.label_medium.font-weight;
                    color: MaterialPalette.on_surface_variant;
                }

                VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_12;
                        background: MaterialPalette.surface_container_high;
                        height: 56px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 25px;
                                    height: 25px;
                                    source: @image-url("../assets/network/25x25/ethernet.svg");
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                MaterialText {
                                    text: "Ethernet Line";
                                    style: MaterialTypography.body_large;
                                }

                                Text {
                                    text: root.network.wired_connected ? root.network.wired_ip : "Disconnected";
                                    font-size: 11px;
                                    opacity: 0.6;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1.0;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 80px;
                                    height: 28px;
                                    border_radius: MaterialStyleMetrics.border_radius_8;
                                    background: root.network.wired_connected ? MaterialPalette.primary_container : MaterialPalette.surface_container_highest;
                                    Text {
                                        text: root.network.wired_connected ? "Active" : "Offline";
                                        color: root.network.wired_connected ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                        font-size: 11px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_12;
                        background: MaterialPalette.surface_container_high;
                        height: 56px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 25px;
                                    height: 25px;
                                    source: !root.network.wifi_enabled ? @image-url("../assets/network/25x25/wifi_off.svg") :
                                        root.network.current_strength < 20 ? @image-url("../assets/network/25x25/wifi_0.svg") :
                                        root.network.current_strength < 40 ? @image-url("../assets/network/25x25/wifi_1.svg") :
                                        root.network.current_strength < 60 ? @image-url("../assets/network/25x25/wifi_2.svg") :
                                        root.network.current_strength < 80 ? @image-url("../assets/network/25x25/wifi_3.svg") :
                                        @image-url("../assets/network/25x25/wifi_4.svg");
                                }
                            }

                            HorizontalLayout {

                                VerticalLayout {
                                    alignment: center;
                                    MaterialText {
                                        text: root.network.current_ssid != "" ? root.network.current_ssid : "Wireless Interface";
                                        style: MaterialTypography.body_large;
                                    }

                                    Text {
                                        text: root.network.wifi_enabled ? root.network.wifi_ip + " • " + root.network.current-strength + "%" : "Hardware Radio Disabled";
                                        font-size: 11px;
                                        opacity: 0.6;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1.0;
                                }

                                if root.network.current_ssid != "": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 32px;
                                        border_radius: MaterialStyleMetrics.border_radius_28;

                                        disc_el := Elevation {
                                            border_radius: parent.border_radius;
                                            background: MaterialPalette.error_container;
                                        }

                                        BaseButton {
                                            border_radius: parent.border_radius;
                                            text: "Disconnect";
                                            color: MaterialPalette.on_error_container;
                                            clicked => { root.disconnect_wifi(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;

                        MaterialText {
                            text: "Wi-Fi";
                            font-size: MaterialTypography.label_medium.font_size;
                            font-weight: MaterialTypography.label_medium.font-weight;
                            color: MaterialPalette.on_surface_variant;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Switch {
                                height_switch: MaterialStyleMetrics.size_24;
                                width_switch: MaterialStyleMetrics.size_40;
                                checked: root.network.wifi_enabled;
                                checked_state_changed(enabled) => { root.set_wifi_enabled(enabled); };
                            }
                        }
                    }

                    Rectangle {
                        border_radius: MaterialStyleMetrics.border_radius_28;
                        elevation_refresh := Elevation {
                            border_radius: parent.border_radius;
                            width: 100%;
                            height: 100%;
                            background: transparent;
                        }

                        base_refresh := BaseButton {
                            border_radius: parent.border_radius;
                            width: 100%;

                            icon: @image-url("../assets/refresh_22.svg");
                            enabled: root.network.wifi-enabled;

                            icon-size: 22px;
                            button_horizontal_padding: MaterialStyleMetrics.padding_8;
                            icon_color: transparent;
                            color: MaterialPalette.on_surface;

                            clicked => {
                                root.refresh_networks();
                            }
                        }

                        states [
                            hover when base_refresh.has_hover && !base_refresh.pressed && !base_refresh.enter_pressed: {
                                elevation_refresh.level: 2;
                                elevation_refresh.background: MaterialPalette.surface_container_high;
                            }
                            pressed when base_refresh.pressed || base_refresh.enter_pressed: {
                                elevation_refresh.level: 1;
                                elevation_refresh.background: MaterialPalette.surface_container_highest;
                            }
                        ]
                    }
                }

                if root.network.wifi_enabled && root.network.wifi_networks.length > 0: Rectangle {
                    width: 100%;

                    vertical-stretch: 1;
                    preferred-height: scroll_content.preferred-height;

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        overlay_scrollbars: true;

                        scroll_content := VerticalLayout {
                            width: 100%;
                            spacing: 6px;
                            padding: 2px;

                            for ap in root.network.wifi_networks: Rectangle {
                                border_radius: MaterialStyleMetrics.border_radius_12;
                                background: MaterialPalette.surface_container_highest;
                                height: 48px;

                                HorizontalLayout {
                                    padding-left: MaterialStyleMetrics.padding_12;
                                    padding-right: MaterialStyleMetrics.padding_8;
                                    spacing: 12px;

                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 25px;
                                            height: 25px;
                                            source: ap.locked ? (
                                                ap.strength < 20 ? @image-url("../assets/network/25x25/wifi_0_locked.svg") :
                                                ap.strength < 40 ? @image-url("../assets/network/25x25/wifi_1_locked.svg") :
                                                ap.strength < 60 ? @image-url("../assets/network/25x25/wifi_2_locked.svg") :
                                                ap.strength < 80 ? @image-url("../assets/network/25x25/wifi_3_locked.svg") :
                                                @image-url("../assets/network/25x25/wifi_4_locked.svg")) : (
                                                ap.strength < 20 ? @image-url("../assets/network/25x25/wifi_0.svg") :
                                                ap.strength < 40 ? @image-url("../assets/network/25x25/wifi_1.svg") :
                                                ap.strength < 60 ? @image-url("../assets/network/25x25/wifi_2.svg") :
                                                ap.strength < 80 ? @image-url("../assets/network/25x25/wifi_3.svg") :
                                                @image-url("../assets/network/25x25/wifi_4.svg"));
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        MaterialText {
                                            text: ap.ssid;
                                            style: MaterialTypography.body_large;
                                        }

                                        Text {
                                            text: "Signal: " + ap.strength + "%";
                                            font-size: 11px;
                                            opacity: 0.6;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1.0;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 32px;
                                            border_radius: MaterialStyleMetrics.border_radius_28;

                                            conn_el := Elevation {
                                                border_radius: parent.border_radius;
                                                background: MaterialPalette.secondary_container;
                                            }

                                            BaseButton {
                                                border_radius: parent.border_radius;
                                                text: "Connect";
                                                color: MaterialPalette.on_secondary_container;
                                                clicked => {
                                                    root.connect_wifi(ap.ssid);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
